# Supabase Configuration
# Copy this file to .env.local and fill in your Supabase project details
# Get these values from: https://supabase.com/dashboard/project/_/settings/api

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co

# Supabase Anonymous/Public Key (safe to use in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Supabase Service Role Key (server-side only, keep secret!)
# Only needed for admin operations on the server
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
